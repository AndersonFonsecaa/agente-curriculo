# Configuração do servidor
PORT=3001

# Escolha UM provedor de IA (preencha apenas um):

# Opção 1: Groq (RECOMENDADO - Grátis e rápido)
IA_PROVIDER=groq
GROQ_API_KEY=gq_sua_chave_aqui

# Opção 2: OpenAI (precisa de créditos)
# IA_PROVIDER=openai
# OPENAI_API_KEY=sk-sua_chave_aqui

# Opção 3: Anthropic (Claude)
# IA_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-sua_chave_aqui

# Opção 4: Google Gemini (pode ter problemas de disponibilidade)
# IA_PROVIDER=google
# GOOGLE_API_KEY=AIza_sua_chave_aqui
